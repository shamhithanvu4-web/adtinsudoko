{
  "name": "sudoku-under-the-hood",
  "version": "1.0.0",
  "description": "Play the puzzle. Discover the algorithm. An interactive DSA lab built on a real Sudoku solver.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node scripts/build.mjs && node --import tsx --test \"tests/e2e/**/*.test.ts\"",
    "test:all": "npm test && npm run test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "generate:puzzles": "node --import tsx scripts/generate-puzzles.ts",
    "cpp": "make -C reference/cpp test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
